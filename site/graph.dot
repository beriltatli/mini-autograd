digraph autograd {
  rankdir=LR;
  node [shape=record, fontname="Helvetica", fontsize=10];
  n0 [color="#77848D", label="{scale|leaf ()|grad -}"];
  n1 [color="#77848D", label="{neg_y|mul (4, 2)|grad -}"];
  n2 [color="#1F6B8F", label="{b|leaf (2,)|grad 1.31}"];
  n3 [color="#1F6B8F", label="{W|leaf (3, 2)|grad 1.1}"];
  n4 [color="#77848D", label="{x|leaf (4, 3)|grad -}"];
  n5 [color="#1F6B8F", label="{matmul1|matmul (4, 2)|grad 0.976}"];
  n6 [color="#1F6B8F", label="{h|add (4, 2)|grad 0.976}"];
  n7 [color="#1F6B8F", label="{pred|relu (4, 2)|grad 1.04}"];
  n8 [color="#1F6B8F", label="{err|add (4, 2)|grad 1.04}"];
  n9 [color="#1F6B8F", label="{sq|mul (4, 2)|grad 0.354}"];
  n10 [color="#1F6B8F", label="{total|sum ()|grad 0.125}"];
  n11 [color="#1F6B8F", label="{loss|mul ()|grad 1}"];
  n4 -> n5;
  n3 -> n5;
  n5 -> n6;
  n2 -> n6;
  n6 -> n7;
  n7 -> n8;
  n1 -> n8;
  n8 -> n9;
  n8 -> n9;
  n9 -> n10;
  n10 -> n11;
  n0 -> n11;
}